<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#190b25">
<title>إلى ريتال ❤️</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap');
*{box-sizing:border-box}
body{margin:0;min-height:100vh;overflow-x:hidden;font-family:'Cairo',sans-serif;color:#fff;
background:radial-gradient(circle at 50% 25%,#61265f 0,#2b1238 38%,#100817 100%);
display:flex;align-items:center;justify-content:center;padding:28px 16px}
.stars,.stars:before,.stars:after{position:fixed;inset:0;pointer-events:none;content:"";background-image:radial-gradient(#fff 1px,transparent 1.5px);background-size:83px 83px;opacity:.23;animation:twinkle 5s ease-in-out infinite alternate}
.stars:before{background-size:127px 127px;background-position:31px 17px;opacity:.2}
.stars:after{background-size:191px 191px;background-position:65px 91px;opacity:.15}
@keyframes twinkle{to{opacity:.55}}
.card{position:relative;z-index:1;width:min(560px,100%);text-align:center;padding:38px 25px 30px;border:1px solid #ffffff2c;border-radius:30px;background:#ffffff10;backdrop-filter:blur(13px);box-shadow:0 20px 80px #0008}
.small{color:#ffc7e7;font-size:15px;letter-spacing:1px}
h1{font-size:clamp(27px,7vw,42px);margin:10px 0 6px;color:#ffe2f2;text-shadow:0 0 18px #ff75c7}
.subtitle{color:#f8d8eb;font-size:17px;margin:0 0 18px}
.heart-wrap{height:205px;display:grid;place-items:center;margin:5px 0}
.heart{font-size:130px;line-height:1;filter:drop-shadow(0 0 10px #ff4ca6);animation:heartbeat 1.25s infinite}
@keyframes heartbeat{0%,100%{transform:scale(1);filter:drop-shadow(0 0 10px #ff4ca6)}15%{transform:scale(1.13);filter:drop-shadow(0 0 28px #ff8acb)}30%{transform:scale(1)}45%{transform:scale(1.09)}}
.message{font-size:clamp(18px,4.5vw,22px);line-height:2;color:#fff;margin:8px auto 18px}
.name{color:#ffb7dc;font-weight:900;text-shadow:0 0 12px #ff65b4}
.love{font-size:30px;font-weight:900;color:#ffd2eb;text-shadow:0 0 16px #ff58ac;margin:8px 0 20px}
button,.file-label{font:700 15px 'Cairo';border:1px solid #ffc0e2;color:#fff;background:linear-gradient(135deg,#d83f91,#8d3ca9);border-radius:999px;padding:11px 20px;cursor:pointer;display:inline-block;box-shadow:0 7px 24px #d83f9144}
button:hover,.file-label:hover{transform:translateY(-2px)}
.controls{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
input{display:none}
audio{width:100%;margin-top:17px;display:none}
.hint{font-size:12px;color:#e8c8df;margin:15px 0 0}
.floating{position:fixed;bottom:-30px;color:#ff9bd0;opacity:.0;animation:floatUp 8s linear infinite;pointer-events:none}
@keyframes floatUp{0%{transform:translateY(0) scale(.7);opacity:0}15%{opacity:.55}85%{opacity:.4}100%{transform:translateY(-110vh) translateX(35px) scale(1.3);opacity:0}}
footer{font-size:12px;color:#d9b5d1;margin-top:20px}
</style>
</head>
<body>
<div class="stars"></div>
<main class="card">
  <div class="small">رسالة صغيرة من القلب ❤️</div>
  <h1>إلى <span class="name">ريتال</span></h1>
  <p class="subtitle">أحلى شهرين ونص فيهم إنتِ ✨</p>
  <div class="heart-wrap"><div class="heart">❤️</div></div>
  <div class="message">
    بقالنا شهرين ونص يا توتي مع بعض،<br>
    وربنا يديمك ليا يا روح قلبييي 💗
  </div>
  <div class="love">بحبك يا ريتال</div>
  <div class="controls">
    <label class="file-label" for="song">🎵 اختار أغنية حب من جهازك</label>
    <input id="song" type="file" accept="audio/*">
    <button id="play" type="button">▶ تشغيل الأغنية</button>
  </div>
  <audio id="audio" controls loop></audio>
  <p class="hint">اختار ملف الأغنية الصوتي من جهازك، وبعدها اضغط تشغيل.</p>
  <footer>مع كل نبضة قلب… ❤️</footer>
</main>
<script>
const audio=document.getElementById('audio');
const file=document.getElementById('song');
const play=document.getElementById('play');
file.addEventListener('change',()=>{
  if(file.files && file.files[0]){
    audio.src=URL.createObjectURL(file.files[0]);
    audio.style.display='block';
    audio.load();
    play.textContent='▶ تشغيل الأغنية';
  }
});
play.addEventListener('click',async()=>{
  if(!audio.src){file.click();return;}
  if(audio.paused){try{await audio.play();play.textContent='⏸ إيقاف مؤقت';}catch(e){}}
  else{audio.pause();play.textContent='▶ تشغيل الأغنية';}
});
for(let i=0;i<15;i++){
  const el=document.createElement('span');
  el.className='floating';el.textContent=['♥','♡','✦'][i%3];
  el.style.left=(Math.random()*100)+'%';
  el.style.animationDelay=(Math.random()*8)+'s';
  el.style.animationDuration=(7+Math.random()*6)+'s';
  el.style.fontSize=(14+Math.random()*22)+'px';
  document.body.appendChild(el);
}
</script>
</body>
</html>